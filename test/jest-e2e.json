{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testEnvironment": "node",
  "testTimeout": 30000,
  "testRegex": ".*\\.(e2e|spec)\\.test\\.ts$",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "collectCoverageFrom": [
    "<rootDir>/src/domain/entities/order.entity.ts",
    "<rootDir>/src/domain/entities/product.entity.ts"
  ],
  "coverageThreshold": {
    "src/domain/entities/order.entity.ts": {
      "branches": 80,
      "functions": 90,
      "lines": 90,
      "statements": 90
    },
    "src/domain/entities/product.entity.ts": {
      "branches": 80,
      "functions": 90,
      "lines": 90,
      "statements": 90
    }
  },
  "moduleNameMapper": {
    "^@application$": "<rootDir>/src/application",
    "^@application/(.*)$": "<rootDir>/src/application/$1",
    "^@domain$": "<rootDir>/src/domain",
    "^@domain/(.*)$": "<rootDir>/src/domain/$1",
    "^@infrastructure$": "<rootDir>/src/infrastructure",
    "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
    "^@presentation$": "<rootDir>/src/presentation",
    "^@presentation/(.*)$": "<rootDir>/src/presentation/$1"
  },
  "transform": { "^.+\\.(t|j)s$": "ts-jest" }
}
