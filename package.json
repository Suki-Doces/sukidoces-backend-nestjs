{
  "name": "suki-doces-api",
  "version": "2.0.0",
  "description": "Suki Doces e-commerce API — NestJS + TypeORM, organized with Clean Architecture",
  "license": "ISC",
  "engines": {
    "node": ">=20.19 <21",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "jest --config ./test/jest-e2e.json --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\" \"eslint.config.mjs\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\" \"package.json\" \"tsconfig.json\" \"tsconfig.build.json\" \"nest-cli.json\" \"test/jest-e2e.json\" \"eslint.config.mjs\" \".prettierrc.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\" \"package.json\" \"tsconfig.json\" \"tsconfig.build.json\" \"nest-cli.json\" \"test/jest-e2e.json\" \"eslint.config.mjs\" \".prettierrc.json\" \".github/workflows/*.yml\"",
    "seed": "ts-node -r tsconfig-paths/register src/infrastructure/persistence/seed.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/infrastructure/persistence/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:adopt:legacy": "ts-node -r tsconfig-paths/register scripts/adopt-legacy-database.ts",
    "check:architecture": "node scripts/check-architecture.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^11.0.3",
    "@sentry/node": "^11.14.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "multer": "^2.5.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "sql.js": "^1.13.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "eslint": {
      "ajv": "^6.14.0"
    },
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "multer": "$multer",
    "qs": "^6.16.1"
  }
}
